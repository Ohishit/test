#include <iostream>  // 引入输入输出库
using namespace std; // 使用标准命名空间

int main() {
    int a, b; // 定义两个整数变量 a 和 b
    
    cout << "请输入两个整数（用空格隔开）: "; 
    cin >> a >> b; // 接收用户输入的数字
    
    int sum = a + b; // 进行加法运算，结果存到 sum 里
    
    cout << "它们的和是: " << sum << endl; // 输出结果
    
    return 0; // 程序结束
}
